<?xml version="1.0"?>
<robot name="panda" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="initial_positions_file"
             default="$(find moveit_resources_panda_moveit_config)/config/initial_positions.yaml"/>
  <xacro:arg name="controllers_file"
             default="$(find moveit_resources_panda_moveit_config)/config/ros2_controllers.yaml"/>

  <xacro:include filename="$(find moveit_resources_panda_description)/urdf/panda.urdf.xacro"/>

  <link name="world"/>
  <joint name="world_to_panda" type="fixed">
    <parent link="world"/>
    <child link="panda_link0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="panda_gazebo.ros2_control.xacro"/>
  <xacro:panda_gazebo_ros2_control
    name="PandaGazeboSystem"
    initial_positions_file="$(arg initial_positions_file)"/>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>