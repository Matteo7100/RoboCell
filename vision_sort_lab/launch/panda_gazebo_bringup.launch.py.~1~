from launch import Action, LaunchDescription
from launch.actions import ExecuteProcess, IncludeLaunchDescription
from launch_ros.actions import Node

from pathlib import Path

import xacro
from launch_ros.parameter_descriptions import ParameterValue

from ament_index_python.packages import get_package_share_directory
from launch.actions import RegisterEventHandler
from launch.event_handlers import OnProcessExit
from launch.launch_description_sources import PythonLaunchDescriptionSource

def generate_launch_description()-> LaunchDescription:
    package_dir = Path(__file__).resolve().parent.parent
    world_path = package_dir / "worlds" / "sort_lab.sdf"
    gazebo = ExecuteProcess(
        cmd=["gz", "sim", "-r", "-v", "3", str(world_path)],
        output="screen"
    )    
    clock_bridge = Node(
        package="ros_gz_bridge",
        executable="parameter_bridge",
        output="screen",
        arguments=["/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock"]
    )
    package_dir = Path(__file__).resolve().parent.parent
    xacro_path = package_dir / "urdf" / "panda_gazebo.urdf.xacro"
    robot_doc = xacro.process_file(str(xacro_path))
    robot_xml = robot_doc.toxml()

    state_publisher = Node(
        package="robot_state_publisher",
        executable="robot_state_publisher",
        output="screen",
        parameters = [{
            "robot_description": ParameterValue(robot_xml, value_type=str),
            "use_sim_time": True
        }],
    )
    spawn_panda = Node(
        package="ros_gz_sim",
        executable="create",
        output="screen",
        arguments=["-world", "sort_lab", "-topic", "/robot_description", "-name", "panda"]
    )


    share_dir = get_package_share_directory("moveit_resources_panda_moveit_config")
    controllers_yaml = Path(share_dir) / "config" / "ros2_controllers.yaml"

    spawn_joint_states = Node(
        package = "controller_manager",
        executable = "spawner",
        output = "screen",
        arguments = ["joint_state_broadcaster", "-c", "/controller_manager", "--controller-manager-timeout", "15"]
    )
    spawn_arm = Node(
        package = "controller_manager",
        executable = "spawner",
        output = "screen",
        arguments = ["panda_arm_controller", "-c", "/controller_manager", "--controller-manager-timeout", "15", "--param-file", str(controllers_yaml)]
    )

    spawn_hand = Node(
        package = "controller_manager",
        executable = "spawner",
        output = "screen",
        arguments = ["panda_hand_controller", "-c", "/controller_manager", "--controller-manager-timeout", "15", "--param-file", str(controllers_yaml)]
    )

    def start_arm_after_broadcaster(event, context) -> list[Node]:
            if context.is_shutdown or event.returncode != 0:
                return []
            else:
                return [spawn_arm]

    arm_after_broadcaster = RegisterEventHandler(
        OnProcessExit(target_action=spawn_joint_states, on_exit=start_arm_after_broadcaster)
    )

    moveit_launch_path = package_dir / "launch" / "panda_gazebo_move_group.launch.py"
    include_moveit = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(str(moveit_launch_path)),
        launch_arguments={"urdf_file": str(xacro_path)}.items(),
    )
    
    def start_hand_after_arm(event, context) -> list[Action]:
        if context.is_shutdown or event.returncode != 0:
            return []
        return [spawn_hand]

    def start_moveit_after_hand(event, context) -> list[Action]:
        if context.is_shutdown or event.returncode != 0:
            return []
        return [include_moveit]

    hand_after_arm = RegisterEventHandler(
        OnProcessExit(
            target_action=spawn_arm,
            on_exit=start_hand_after_arm,
        )
    )

    moveit_after_hand = RegisterEventHandler(
        OnProcessExit(
            target_action=spawn_hand,
            on_exit=start_moveit_after_hand,
        )
    )

    return LaunchDescription([
        gazebo,
        clock_bridge,
        state_publisher,
        spawn_panda,
        arm_after_broadcaster,
        hand_after_arm,
        moveit_after_hand,
        spawn_joint_states,
    ])